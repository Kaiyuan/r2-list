                height: 100%;
                clicked => { root.location-editor-visible = false; }
            }

            HorizontalLayout {
                alignment: center;
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: min(470px, root.width - 40px);
                        height: min(640px, root.height - 40px);
                        border-color: root.line;
                        border-width: 1px;
                        border-radius: 9px;
                        background: root.panel;
                        clip: true;

                        TouchArea {
                            width: 100%;
                            height: 100%;
                        }

                        VerticalLayout {
                            padding: 24px;
                            spacing: 0px;

                            HorizontalLayout {
                                height: 46px;
                                spacing: 12px;
                                VerticalLayout {
                                    alignment: start;
                                    spacing: 5px;
                                    Text { text: root.text-locations; color: root.muted; font-size: 9px; font-weight: 500; }
                                    Text { text: root.text-location-settings; color: root.ink; font-size: 20px; font-weight: 700; }
                                }
                                Rectangle { horizontal-stretch: 1; background: Colors.transparent; }
                                VerticalLayout {
                                    height: 46px;
                                    alignment: center;
                                    IconAction {
                                        icon-name: "close";
                                        control-width: 31px;
                                        control-height: 31px;
                                        icon-size: 18px;
                                        surface: Colors.transparent;
                                        hover-surface: root.panel-soft;
                                        icon-color: root.muted;
                                        outline: Colors.transparent;
                                        clicked => { root.location-editor-visible = false; }
                                    }
                                }
                            }

                            Rectangle { height: 8px; background: Colors.transparent; }

                            ScrollView {
                                vertical-stretch: 1;

                                VerticalLayout {
                                    spacing: 10px;
                                    padding-right: 12px;

                                    VerticalLayout {
                                        spacing: 6px;
                                        Text { text: root.text-location-name; color: root.ink-soft; font-size: 10px; font-weight: 600; }
                                        FieldInput {
                                            field-bg: root.field-bg;
                                            outline: root.line-strong;
                                            muted: root.muted;
                                            height: 36px;
                                            text <=> root.location-label;
                                            ink: root.ink;
                                            font-size: 10px;
                                        }
                                    }

                                    if root.location-kind == "webdav": VerticalLayout {
                                        spacing: 10px;
                                        VerticalLayout {
                                            spacing: 6px;
                                            Text { text: root.text-server-address; color: root.ink-soft; font-size: 10px; font-weight: 600; }
                                            FieldInput {
                                                field-bg: root.field-bg;
                                                outline: root.line-strong;
                                                muted: root.muted;
                                                height: 36px;
                                                text <=> root.location-endpoint;
                                                ink: root.ink;
                                                font-size: 10px;
                                            }
                                        }
                                        VerticalLayout {
                                            spacing: 6px;
                                            Text { text: root.text-username; color: root.ink-soft; font-size: 10px; font-weight: 600; }
                                            FieldInput {
                                                field-bg: root.field-bg;
                                                outline: root.line-strong;
                                                muted: root.muted;
                                                height: 36px;
                                                text <=> root.location-username;
                                                ink: root.ink;
                                                font-size: 10px;
                                            }
                                        }
                                        VerticalLayout {
                                            spacing: 6px;
                                            Text { text: root.text-password; color: root.ink-soft; font-size: 10px; font-weight: 600; }
                                            FieldInput {
                                                field-bg: root.field-bg;
                                                outline: root.line-strong;
                                                muted: root.muted;
                                                height: 36px;
                                                text <=> root.location-password;
                                                password: true;
                                                ink: root.ink;
                                                font-size: 10px;
                                            }
                                        }
                                    }

                                    Rectangle { height: 4px; background: Colors.transparent; }
                                    Text { text: root.text-url-rules; color: root.ink; font-size: 13px; font-weight: 700; height: 20px; vertical-alignment: center; }

                                    VerticalLayout {
                                        spacing: 6px;
                                        Text { text: root.text-public-base-url; color: root.ink-soft; font-size: 10px; font-weight: 600; }
                                        FieldInput {
                                            field-bg: root.field-bg;
                                            outline: root.line-strong;
                                            muted: root.muted;
                                            height: 36px;
                                            text <=> root.base-url;
                                            placeholder-text: "https://cdn.example.com";
                                            edited => { root.preview-rules(root.base-url, root.prefix, root.bucket, root.template); }
                                            ink: root.ink;
                                            font-size: 10px;
                                        }
                                    }
                                    VerticalLayout {
                                        spacing: 6px;
                                        Text { text: root.text-object-prefix; color: root.ink-soft; font-size: 10px; font-weight: 600; }
                                        FieldInput {
                                            field-bg: root.field-bg;
                                            outline: root.line-strong;
                                            muted: root.muted;
                                            height: 36px;
                                            text <=> root.prefix;
                                            edited => { root.preview-rules(root.base-url, root.prefix, root.bucket, root.template); }
                                            ink: root.ink;
                                            font-size: 10px;
                                        }
                                    }
                                    VerticalLayout {
                                        spacing: 6px;
                                        Text { text: root.text-bucket; color: root.ink-soft; font-size: 10px; font-weight: 600; }
                                        FieldInput {
                                            field-bg: root.field-bg;
                                            outline: root.line-strong;
                                            muted: root.muted;
                                            height: 36px;
                                            text <=> root.bucket;
                                            edited => { root.preview-rules(root.base-url, root.prefix, root.bucket, root.template); }
                                            ink: root.ink;
                                            font-size: 10px;
                                        }
                                    }
                                    VerticalLayout {
                                        spacing: 6px;
                                        Text { text: root.text-template; color: root.ink-soft; font-size: 10px; font-weight: 600; }
                                        FieldInput {
                                            field-bg: root.field-bg;
                                            outline: root.line-strong;
                                            muted: root.muted;
                                            height: 36px;
                                            text <=> root.template;
                                            edited => { root.preview-rules(root.base-url, root.prefix, root.bucket, root.template); }
                                            ink: root.ink;
                                            font-size: 10px;
                                        }
                                    }
                                    Text {
                                        text: root.text-template-help;
                                        color: root.muted;
                                        font-size: 9px;
                                        wrap: word-wrap;
                                    }
                                    Rectangle {
                                        width: 100%;
                                        height: 42px;
                                        border-radius: 5px;
                                        background: root.panel-soft;
                                        VerticalLayout {
                                            padding-left: 9px;
                                            padding-right: 9px;
                                            Text { text: root.text-public-base-url; color: root.muted; font-size: 9px; }
                                            Text { text: root.location-preview; color: root.ink-soft; font-size: 9px; wrap: word-wrap; overflow: elide; }
                                        }
                                    }

                                    Rectangle { vertical-stretch: 1; background: Colors.transparent; }
                                }
                            }

                            Rectangle { height: 14px; background: Colors.transparent; }
                            HorizontalLayout {
                                height: 34px;
                                spacing: 8px;
                                Rectangle { horizontal-stretch: 1; background: Colors.transparent; }
                                IconAction {
                                    label: root.text-cancel;
                                    auto-width: true;
                                    control-height: 34px;
                                    surface: root.panel;
                                    hover-surface: root.panel-soft;
                                    foreground: root.ink-soft;
                                    icon-color: root.muted;
                                    outline: root.line-strong;
                                    border-thickness: 1px;
                                    clicked => { root.location-editor-visible = false; }
                                }
                                IconAction {
                                    icon-name: "link";
                                    label: root.text-save-location;
                                    auto-width: true;
                                    control-height: 34px;
                                    surface: root.primary;
                                    hover-surface: root.primary-hover;
                                    foreground: root.primary-ink;
                                    icon-color: root.primary-ink;
                                    outline: root.primary;
                                    border-thickness: 1px;
                                    clicked => {
                                        root.save-settings(root.location-label, root.base-url, root.prefix, root.bucket, root.template, root.location-endpoint, root.location-username, root.location-password);
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        if root.webdav-visible: Rectangle {
            x: 0px;
            y: 0px;
            width: 100%;
            height: 100%;
            background: #121b2861;

            TouchArea {
                width: 100%;
                height: 100%;
                clicked => { root.webdav-visible = false; }
            }

            HorizontalLayout {
                alignment: center;
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: min(470px, root.width - 40px);
                        height: min(410px, root.height - 40px);
                        border-color: root.line;
                        border-width: 1px;
                        border-radius: 9px;
                        background: root.panel;
                        clip: true;

                        TouchArea {
                            width: 100%;
                            height: 100%;
                        }

                        VerticalLayout {
                            padding: 24px;
                            spacing: 0px;

                            HorizontalLayout {
                                height: 46px;
                                spacing: 12px;
                                VerticalLayout {
                                    alignment: start;
                                    spacing: 5px;
                                    Text { text: root.text-locations; color: root.muted; font-size: 9px; font-weight: 500; }
                                    Text { text: root.text-connect-webdav; color: root.ink; font-size: 20px; font-weight: 700; }
                                }
                                Rectangle { horizontal-stretch: 1; background: Colors.transparent; }
                                VerticalLayout {
                                    height: 46px;
                                    alignment: center;
                                    IconAction {
                                        icon-name: "close";
                                        control-width: 31px;
                                        control-height: 31px;
                                        icon-size: 18px;
                                        surface: Colors.transparent;
                                        hover-surface: root.panel-soft;
                                        icon-color: root.muted;
                                        outline: Colors.transparent;
                                        clicked => { root.webdav-visible = false; }
                                    }
                                }
                            }

                            Rectangle { height: 8px; background: Colors.transparent; }

                            VerticalLayout {
                                spacing: 10px;
                                VerticalLayout {
                                    spacing: 6px;
                                    Text { text: root.text-server-address; color: root.ink-soft; font-size: 10px; font-weight: 600; }
                                    FieldInput {
                                        field-bg: root.field-bg;
                                        outline: root.line-strong;
                                        muted: root.muted;
                                        height: 36px;
                                        text <=> root.webdav-endpoint;
                                        placeholder-text: "https://dav.example.com/remote.php/dav/files/user";
                                        ink: root.ink;
                                        font-size: 10px;
                                    }
                                }
                                VerticalLayout {
                                    spacing: 6px;
                                    Text { text: root.text-username; color: root.ink-soft; font-size: 10px; font-weight: 600; }
                                    FieldInput {
                                        field-bg: root.field-bg;
                                        outline: root.line-strong;
                                        muted: root.muted;
                                        height: 36px;
                                        text <=> root.webdav-username;
                                        ink: root.ink;
                                        font-size: 10px;
                                    }
                                }
                                VerticalLayout {
                                    spacing: 6px;
                                    Text { text: root.text-password; color: root.ink-soft; font-size: 10px; font-weight: 600; }
                                    FieldInput {
                                        field-bg: root.field-bg;
                                        outline: root.line-strong;
                                        muted: root.muted;
                                        height: 36px;
                                        text <=> root.webdav-password;
                                        password: true;
                                        ink: root.ink;
                                        font-size: 10px;
                                    }
                                }
                            }

                            Rectangle { vertical-stretch: 1; background: Colors.transparent; }

                            HorizontalLayout {
                                height: 34px;
                                spacing: 8px;
                                Rectangle { horizontal-stretch: 1; background: Colors.transparent; }
                                IconAction {
                                    label: root.text-cancel;
                                    auto-width: true;
                                    control-height: 34px;
                                    surface: root.panel;
                                    hover-surface: root.panel-soft;
                                    foreground: root.ink-soft;
                                    icon-color: root.muted;
                                    outline: root.line-strong;
                                    border-thickness: 1px;
                                    clicked => { root.webdav-visible = false; }
                                }
                                IconAction {
                                    icon-name: "cloud";
                                    label: root.text-connect;
                                    auto-width: true;
                                    control-height: 34px;
                                    surface: root.primary;
                                    hover-surface: root.primary-hover;
                                    foreground: root.primary-ink;
                                    icon-color: root.primary-ink;
                                    outline: root.primary;
                                    border-thickness: 1px;
                                    clicked => {
                                        root.connect-webdav(root.webdav-endpoint, root.webdav-username, root.webdav-password);
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        if root.new-folder-visible: Rectangle {
            x: 0px;
            y: 0px;
            width: 100%;
            height: 100%;
            background: #121b2861;

            TouchArea {
                width: 100%;
                height: 100%;
                clicked => { root.new-folder-visible = false; }
            }

            HorizontalLayout {
                alignment: center;
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: min(420px, root.width - 40px);
                        height: 236px;
                        border-color: root.line;
                        border-width: 1px;
                        border-radius: 9px;
                        background: root.panel;
                        clip: true;

                        TouchArea {
                            width: 100%;
                            height: 100%;
                        }

                        VerticalLayout {
                            padding: 24px;
                            spacing: 0px;

                            HorizontalLayout {
                                height: 46px;
                                spacing: 12px;
                                VerticalLayout {
                                    alignment: start;
                                    spacing: 5px;
                                    Text { text: root.text-workspace; color: root.muted; font-size: 9px; font-weight: 500; }
                                    Text { text: root.text-new-folder; color: root.ink; font-size: 20px; font-weight: 700; }
                                }
                                Rectangle { horizontal-stretch: 1; background: Colors.transparent; }
                                VerticalLayout {
                                    height: 46px;
                                    alignment: center;
                                    IconAction {
                                        icon-name: "close";
                                        control-width: 31px;
                                        control-height: 31px;
                                        icon-size: 18px;
                                        surface: Colors.transparent;
                                        hover-surface: root.panel-soft;
                                        icon-color: root.muted;
                                        outline: Colors.transparent;
                                        clicked => { root.new-folder-visible = false; }
                                    }
                                }
                            }

                            Rectangle { height: 10px; background: Colors.transparent; }

                            VerticalLayout {
                                spacing: 6px;
                                Text { text: root.text-folder-name; color: root.ink-soft; font-size: 10px; font-weight: 600; }
                                FieldInput {
                                    field-bg: root.field-bg;
                                    outline: root.line-strong;
                                    muted: root.muted;
                                    height: 36px;
                                    text <=> root.new-folder-name;
                                    ink: root.ink;
                                    font-size: 10px;
                                }
                            }

                            Rectangle { vertical-stretch: 1; background: Colors.transparent; }

                            HorizontalLayout {
                                height: 34px;
                                spacing: 8px;
                                Rectangle { horizontal-stretch: 1; background: Colors.transparent; }
                                IconAction {
                                    label: root.text-cancel;
                                    auto-width: true;
                                    control-height: 34px;
                                    surface: root.panel;
                                    hover-surface: root.panel-soft;
                                    foreground: root.ink-soft;
                                    icon-color: root.muted;
                                    outline: root.line-strong;
                                    border-thickness: 1px;
                                    clicked => { root.new-folder-visible = false; }
                                }
                                IconAction {
                                    icon-name: "folder-plus";
                                    label: root.text-create-folder;
                                    auto-width: true;
                                    control-height: 34px;
                                    surface: root.primary;
                                    hover-surface: root.primary-hover;
                                    foreground: root.primary-ink;
                                    icon-color: root.primary-ink;
                                    outline: root.primary;
                                    border-thickness: 1px;
                                    clicked => { root.create-folder(root.new-folder-name); }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
