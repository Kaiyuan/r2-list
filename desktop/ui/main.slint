                                            spacing: 14px;
                                            Text { text: "GitHub"; color: root.muted; font-size: 12px; vertical-alignment: center; }
                                            Rectangle { horizontal-stretch: 1; background: Colors.transparent; }
                                            StatusPill {
                                                kind: root.github-status-kind;
                                                text: root.github-status;
                                                panel-soft: root.panel-soft;
                                                accent-soft: root.accent-soft;
                                                accent-strong: root.accent-strong;
                                                amber-soft: root.amber-soft;
                                                amber-ink: root.amber-ink;
                                                muted: root.muted;
                                                danger: root.danger;
                                                danger-soft: root.danger-soft;
                                            }
                                        }
                                        Rectangle { height: 12px; background: Colors.transparent; }
                                        HorizontalLayout {
                                            height: 34px;
                                            spacing: 8px;
                                            IconAction {
                                                icon-name: "refresh";
                                                label: root.text-check-updates;
                                                auto-width: true;
                                                control-height: 34px;
                                                surface: root.panel;
                                                hover-surface: root.panel-soft;
                                                foreground: root.ink-soft;
                                                icon-color: root.muted;
                                                outline: root.line-strong;
                                                border-thickness: 1px;
                                                clicked => { root.check-updates(); }
                                            }
                                            IconAction {
                                                icon-name: "link";
                                                label: root.text-check-connection;
                                                auto-width: true;
                                                control-height: 34px;
                                                surface: root.panel;
                                                hover-surface: root.panel-soft;
                                                foreground: root.ink-soft;
                                                icon-color: root.muted;
                                                outline: root.line-strong;
                                                border-thickness: 1px;
                                                clicked => { root.check-github(); }
                                            }
                                        }
                                    }

                                    Rectangle { height: 1px; background: root.line; }
                                    VerticalLayout {
                                        padding-top: 16px;
                                        padding-bottom: 16px;
                                        spacing: 0px;
                                        Text { text: root.text-github-project; color: root.ink; font-size: 13px; font-weight: 700; height: 20px; vertical-alignment: center; }
                                        Rectangle { height: 9px; background: Colors.transparent; }
                                        Text {
                                            text: root.text-github-description;
                                            color: root.muted;
                                            font-size: 11px;
                                            wrap: word-wrap;
                                        }
                                        Rectangle { height: 12px; background: Colors.transparent; }
                                        HorizontalLayout {
