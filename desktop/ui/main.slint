                                    VerticalLayout {
                                        padding-top: 16px;
                                        padding-bottom: 16px;
                                        spacing: 0px;
                                        Text { text: root.text-about-updates; color: root.ink; font-size: 13px; font-weight: 700; height: 20px; vertical-alignment: center; }
                                        Rectangle { height: 9px; background: Colors.transparent; }
                                        HorizontalLayout {
                                            height: 24px;
                                            spacing: 14px;
                                            Text { text: root.text-version; color: root.muted; font-size: 12px; vertical-alignment: center; }
                                            Rectangle { horizontal-stretch: 1; background: Colors.transparent; }
                                            Text { text: root.app-version; color: root.ink; font-size: 12px; font-weight: 600; vertical-alignment: center; }
                                        }
