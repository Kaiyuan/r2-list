                                                accent-soft: root.accent-soft;
                                                accent-strong: root.accent-strong;
                                                amber-soft: root.amber-soft;
                                                amber-ink: root.amber-ink;
                                                muted: root.muted;
                                                danger: root.danger;
                                                danger-soft: root.danger-soft;
                                            }
                                        }
                                        HorizontalLayout {
