import { Palette, ScrollView } from "std-widgets.slint";

export struct FileRow {
    name: string,
    path: string,
    kind: string,
    size: string,
    modified: string,
    is-directory: bool,
    thumbnail: image,
    has-thumbnail: bool,
}

export struct LocationRow {
    path: string,
    label: string,
    kind: string,
    is-active: bool,
}

export struct BreadcrumbRow {
    label: string,
    path: string,
}

export struct SiblingFolder {
    name: string,
    path: string,
    is-current: bool,
}

component UiIcon inherits Rectangle {
    in property <string> name;
    in property <length> size: 16px;
    in property <length> frame-height: size;
    in property <color> tint: #91a2b7;
    width: size;
    height: frame-height;
    Image {
        y: (root.height - root.size) / 2;
        width: root.size;
        height: root.size;
        image-fit: contain;
        colorize: root.tint;
        source: root.name == "cloud" ? @image-url("icons/cloud.svg")
            : root.name == "files" ? @image-url("icons/files.svg")
            : root.name == "sliders" ? @image-url("icons/sliders.svg")
            : root.name == "drive" ? @image-url("icons/hard-drive.svg")
            : root.name == "plus" ? @image-url("icons/plus.svg")
            : root.name == "folder" ? @image-url("icons/folder.svg")
            : root.name == "upload" ? @image-url("icons/upload.svg")
            : root.name == "search" ? @image-url("icons/search.svg")
            : root.name == "folder-plus" ? @image-url("icons/folder-plus.svg")
            : root.name == "refresh" ? @image-url("icons/refresh.svg")
            : root.name == "more" ? @image-url("icons/more.svg")
            : root.name == "back" ? @image-url("icons/arrow-left.svg")
            : root.name == "image" ? @image-url("icons/image.svg")
            : root.name == "copy" ? @image-url("icons/copy.svg")
            : root.name == "code" ? @image-url("icons/code.svg")
            : root.name == "external" ? @image-url("icons/external.svg")
            : root.name == "trash" ? @image-url("icons/trash.svg")
            : root.name == "shield" ? @image-url("icons/shield.svg")
            : root.name == "moon" ? @image-url("icons/moon.svg")
            : root.name == "sun" ? @image-url("icons/sun.svg")
            : root.name == "language" ? @image-url("icons/language.svg")
            : root.name == "link" ? @image-url("icons/link.svg")
            : root.name == "close" ? @image-url("icons/close.svg")
            : root.name == "list" ? @image-url("icons/list.svg")
            : root.name == "grid" ? @image-url("icons/grid.svg")
            : root.name == "chevron-right" ? @image-url("icons/chevron-right.svg")
            : root.name == "chevron-down" ? @image-url("icons/chevron-down.svg")
            : root.name == "chevron-up" ? @image-url("icons/chevron-up.svg")
            : root.name == "home" ? @image-url("icons/home.svg")
            : root.name == "clipboard-paste" ? @image-url("icons/clipboard-paste.svg")
            : root.name == "pencil" ? @image-url("icons/pencil.svg")
            : root.name == "video" ? @image-url("icons/video.svg")
            : root.name == "audio" ? @image-url("icons/audio.svg")
            : root.name == "archive" ? @image-url("icons/archive.svg")
            : root.name == "document" ? @image-url("icons/document.svg")
            : root.name == "text" ? @image-url("icons/text.svg")
            : root.name == "download" ? @image-url("icons/download.svg")
            : root.name == "move" ? @image-url("icons/move.svg")
            : root.name == "sidebar-right" ? @image-url("icons/sidebar-right.svg")
            : root.name == "sidebar-right-open" ? @image-url("icons/sidebar-right-open.svg")
            : @image-url("icons/file.svg");
    }
}

component RowText inherits Text {
    in property <length> row-height: 36px;
    height: row-height;
    vertical-alignment: center;
}

component PathCrumb inherits Rectangle {
    in property <string> label;
    in property <bool> current: false;
    in property <color> ink: #1f262e;
    in property <color> muted: #848d99;
    in property <color> accent: #2563a8;
    in property <color> accent-soft: #e9f1fb;
    in property <color> panel-soft: #f7f9fc;
    callback clicked;
    height: 18px;
    width: min(path-label.preferred-width + 10px, 220px);
    border-radius: 4px;
    background: path-hit.has-hover ? (root.current ? root.accent-soft : root.panel-soft) : Colors.transparent;

    path-label := Text {
        x: 5px;
        width: parent.width - 10px;
        height: parent.height;
        text: root.label;
        color: path-hit.has-hover ? root.accent : (root.current ? root.ink : root.muted);
        font-size: 10px;
        font-weight: root.current ? 600 : 400;
        vertical-alignment: center;
        overflow: elide;
    }

    path-hit := TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.clicked(); }
    }
}

component FieldInput inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder-text;
    in property <bool> password: false;
    in property <bool> flat: false;
    in property <color> field-bg: #ffffff;
    in property <color> outline: #dce2ea;
    in property <color> ink: #1f262e;
    in property <color> muted: #848d99;
    in property <length> font-size: 11px;
    in property <length> field-radius: 5px;
    in property <length> inset: 9px;
    callback edited;
    callback accepted;
    public function focus-input() {
        search-input.focus();
    }
    background: flat ? Colors.transparent : field-bg;
    border-color: flat ? Colors.transparent : outline;
    border-width: flat ? 0px : 1px;
    border-radius: flat ? 0px : field-radius;

    if text == "" && placeholder-text != "": Text {
        x: flat ? 0px : inset + 1px;
        width: parent.width - (flat ? 0px : inset * 2 + 2px);
        height: parent.height;
        text: root.placeholder-text;
        color: root.muted;
        font-size: root.font-size;
        vertical-alignment: center;
        overflow: elide;
    }
    search-input := TextInput {
        x: flat ? 0px : inset;
        y: 0px;
        width: parent.width - (flat ? 0px : inset * 2);
        height: parent.height;
        color: root.ink;
        font-size: root.font-size;
        vertical-alignment: center;
        single-line: true;
        input-type: root.password ? InputType.password : InputType.text;
        text <=> root.text;
        edited => { root.edited(); }
        accepted => { root.accepted(); }
    }
}

component TextButton inherits Text {
    callback clicked;
    height: 18px;
    vertical-alignment: center;
    TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.clicked(); }
    }
}

component IconAction inherits Rectangle {
    in property <string> icon-name: "";
    in property <string> label: "";
    in property <length> control-height: 34px;
    in property <length> control-width: label == "" ? control-height : (icon-name == "" ? 72px : 84px);
    in property <color> surface: #ffffff;
    in property <color> hover-surface: surface;
    in property <color> foreground: #4c5663;
    in property <color> icon-color: #848d99;
    in property <color> outline: Colors.transparent;
    in property <length> border-thickness: 0px;
    in property <length> icon-size: 15px;
    in property <length> corner-radius: 6px;
    in property <length> font-size: 10px;
    in property <int> font-weight: 600;
    in property <bool> auto-width: false;
    out property <bool> hovered: action-hit.has-hover;
    callback clicked;
    width: auto-width ? content-row.preferred-width : control-width;
    height: control-height;
    border-color: outline;
    border-width: border-thickness;
    border-radius: corner-radius;
    background: action-hit.has-hover ? hover-surface : surface;

    content-row := HorizontalLayout {
        width: 100%;
        height: 100%;
        alignment: center;
        padding-left: label == "" ? 0px : (icon-name == "" ? 12px : 10px);
        padding-right: label == "" ? 0px : (icon-name == "" ? 12px : 10px);
        spacing: 7px;
        if icon-name != "": UiIcon {
            name: icon-name;
            size: icon-size;
            frame-height: root.height;
            tint: icon-color;
        }
        if label != "": Text {
            text: label;
            color: foreground;
            height: root.height;
            font-size: font-size;
            font-weight: font-weight;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
    }

    action-hit := TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.clicked(); }
    }
}

component StatusPill inherits Rectangle {
    in property <string> kind: "idle";
    in property <string> text;
    in property <color> panel-soft: #f7f9fc;
    in property <color> accent-soft: #e9f1fb;
    in property <color> accent-strong: #1b4f87;
    in property <color> amber-soft: #f7f0e6;
    in property <color> amber-ink: #855318;
    in property <color> muted: #848d99;
    in property <color> danger: #b94b4b;
    in property <color> danger-soft: #f7e9e9;
    height: 24px;
    width: min(pill-label.preferred-width + 20px, 340px);
    border-radius: 12px;
    background: kind == "checking" || kind == "ok" ? accent-soft
        : kind == "update" ? amber-soft
        : kind == "error" ? danger-soft
        : panel-soft;

    pill-label := Text {
        x: 10px;
        width: parent.width - 20px;
        height: parent.height;
        text: root.text;
        color: root.kind == "checking" || root.kind == "ok" ? root.accent-strong
            : root.kind == "update" ? root.amber-ink
            : root.kind == "error" ? root.danger
            : root.muted;
        font-size: 11px;
        vertical-alignment: center;
        overflow: elide;
    }
}

component CodeChip inherits Rectangle {
    in property <string> text;
    in property <color> ink-soft: #4c5663;
    in property <color> panel-soft: #f7f9fc;
    height: 20px;
    width: min(chip-label.preferred-width + 14px, 340px);
    border-radius: 4px;
    background: panel-soft;

    chip-label := Text {
        x: 7px;
        width: parent.width - 14px;
        height: parent.height;
        text: root.text;
        color: root.ink-soft;
        font-size: 10px;
        vertical-alignment: center;
        overflow: elide;
    }
}

component ToolbarButton inherits Rectangle {
    in property <string> icon-name;
    in property <string> label;
    in property <color> ink: #4c5663;
    in property <color> muted: #848d99;
    in property <color> panel-soft: #f7f9fc;
    callback clicked;
    height: 31px;
    width: toolbar-label.preferred-width + 42px;
    border-radius: 5px;
    background: toolbar-hit.has-hover ? root.panel-soft : Colors.transparent;

    toolbar-label := Text {
        x: 30px;
        width: parent.width - 38px;
        height: 100%;
        text: root.label;
        color: root.ink;
        font-size: 10px;
        vertical-alignment: center;
    }
    UiIcon {
        x: 8px;
        name: root.icon-name;
        size: 16px;
        frame-height: root.height;
        tint: root.muted;
    }
    toolbar-hit := TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.clicked(); }
    }
}

component SelectPill inherits Rectangle {
    in property <string> icon-name;
    in property <string> value;
    in property <length> control-width: 100px;
    in property <color> ink: #4c5663;
    in property <color> muted: #848d99;
    in property <color> line: #e7ebf0;
    in property <color> panel-soft: #f7f9fc;
    callback clicked;
    width: control-width;
    height: 30px;
    border-color: pill-hit.has-hover ? ink : line;
    border-width: 1px;
    border-radius: 6px;
    background: panel-soft;

    HorizontalLayout {
        width: 100%;
        height: 100%;
        padding-left: 7px;
        padding-right: 7px;
        spacing: 6px;
        UiIcon {
            name: root.icon-name;
            size: 14px;
            frame-height: root.height;
            tint: root.muted;
        }
        RowText {
            row-height: root.height;
            text: root.value;
            color: root.ink;
            font-size: 10px;
            horizontal-stretch: 1;
            overflow: elide;
        }
        UiIcon {
            name: "chevron-down";
            size: 10px;
            frame-height: root.height;
            tint: root.muted;
        }
    }

    pill-hit := TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.clicked(); }
    }
}

component ContextMenuItem inherits Rectangle {
    in property <string> icon-name;
    in property <string> label;
    in property <bool> destructive: false;
    in property <color> foreground: #4c5663;
    in property <color> muted: #848d99;
    in property <color> accent-strong: #1b4f87;
    in property <color> accent-soft: #e9f1fb;
    callback clicked;
    width: 100%;
    height: 32px;
    border-radius: 4px;
    background: menu-hit.has-hover ? (destructive ? #b94b4b18 : root.accent-soft) : Colors.transparent;

    HorizontalLayout {
        height: 32px;
        padding-left: 8px;
        padding-right: 8px;
        spacing: 9px;
        UiIcon {
            name: icon-name;
            size: 15px;
            frame-height: 32px;
            tint: destructive ? #b94b4b : (menu-hit.has-hover ? root.accent-strong : root.muted);
        }
        RowText {
            row-height: 32px;
            text: label;
            color: destructive ? #b94b4b : (menu-hit.has-hover ? root.accent-strong : foreground);
            font-size: 10px;
            horizontal-stretch: 1;
        }
    }

    menu-hit := TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.clicked(); }
    }
}
export component MainWindow inherits Window {
    title: "R2 List";
    icon: @image-url("icons/app-icon.png");
    preferred-width: 1280px;
    preferred-height: 820px;
