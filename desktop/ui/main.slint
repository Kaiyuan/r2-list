                                    VerticalLayout {
                                        padding-top: 16px;
                                        padding-bottom: 16px;
                                        spacing: 0px;
                                        Text { text: root.text-configuration; color: root.ink; font-size: 13px; font-weight: 700; height: 20px; vertical-alignment: center; }
                                        Rectangle { height: 9px; background: Colors.transparent; }
                                        HorizontalLayout {
                                            height: 24px;
                                            spacing: 14px;
                                            Text { text: root.text-config-folder; color: root.muted; font-size: 12px; vertical-alignment: center; }
                                            Rectangle { horizontal-stretch: 1; background: Colors.transparent; }
                                            CodeChip {
                                                text: root.config-directory;
                                                ink-soft: root.ink-soft;
                                                panel-soft: root.panel-soft;
                                            }
                                        }
                                        HorizontalLayout {
                                            height: 24px;
                                            spacing: 14px;
                                            Text { text: root.text-config-file; color: root.muted; font-size: 12px; vertical-alignment: center; }
                                            Rectangle { horizontal-stretch: 1; background: Colors.transparent; }
                                            CodeChip {
                                                text: root.config-file;
                                                ink-soft: root.ink-soft;
                                                panel-soft: root.panel-soft;
                                            }
                                        }
                                        Rectangle { height: 6px; background: Colors.transparent; }
                                        Text {
                                            text: root.text-config-hint;
                                            color: root.muted;
                                            font-size: 11px;
                                            wrap: word-wrap;
                                        }
                                        Rectangle { height: 12px; background: Colors.transparent; }
                                        HorizontalLayout {
                                            height: 34px;
                                            spacing: 8px;
                                            IconAction {
